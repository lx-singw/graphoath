# Copy this file to .env and fill in real values. Never commit .env itself.

# DataHub connection
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_TOKEN=

# Postgres (Custody ledger + operational state)
DATABASE_URL=postgresql://graphoath:graphoath@localhost:5432/graphoath

# Slack notifications for raised incidents and approval requests
SLACK_WEBHOOK_URL=

# Dashboard auth
JWT_SECRET=

# Dashboard (src/dashboard/.env.local should set this separately)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
