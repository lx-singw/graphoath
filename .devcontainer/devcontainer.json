{
  "name": "GraphOath Hackathon Dev Environment",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:1": {}
  },
  "postCreateCommand": "pip install -e . && python scripts/fast_track_evaluation.py",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  "portsAttributes": {
    "3000": {
      "label": "Next.js Operator Dashboard",
      "onAutoForward": "notify"
    },
    "8000": {
      "label": "FastAPI GraphOath Backend",
      "onAutoForward": "notify"
    }
  },
  "forwardPorts": [3000, 8000]
}
